# mcp-edge example

MCP_PLATFORM_ENV=production
MCP_PLATFORM_LOG_LEVEL=info
MCP_PLATFORM_DATABASE_URL=file:/data/mcp-platform/mcp-platform.db

MCP_EDGE_HTTP_BIND_ADDR=:8080
MCP_EDGE_PUBLIC_BASE_URL=https://mcp.example.com

MCP_EDGE_AUTHENTIK_ISSUER_URL=https://auth.example.com/application/o/mcp-edge/
MCP_EDGE_AUTHENTIK_CLIENT_ID=mcp-edge
MCP_EDGE_AUTHENTIK_CLIENT_SECRET_PATH=/run/secrets/mcp-edge-authentik-client-secret

MCP_EDGE_OPERATOR_TOKEN_PATH=/run/secrets/mcp-edge-operator-token
MCP_EDGE_SESSION_ENCRYPTION_KEY_PATH=/run/secrets/mcp-edge-session-encryption-key
MCP_EDGE_COOKIE_SECURE=true
# Comma-separated origins allowed to call the edge from browsers. Leave empty to disable CORS.
MCP_EDGE_CORS_ALLOWED_ORIGINS=

# Optional MCP client onboarding compatibility.
MCP_EDGE_DCR_ENABLED=false
MCP_EDGE_CIMD_ENABLED=false

# OAuth lifetime policy. Increase refresh TTL before access TTL when reducing reauth frequency.
# Values accept Go duration syntax plus a whole-day suffix such as 7d.
# Access tokens are bearer credentials and are capped at 24h by mcp-edge validation.
# Refresh tokens are capped at 30d; authorization/device codes are capped at 30m.
MCP_EDGE_OAUTH_ACCESS_TOKEN_TTL=2h
MCP_EDGE_OAUTH_REFRESH_TOKEN_TTL=72h
MCP_EDGE_OAUTH_AUTHORIZATION_CODE_TTL=10m
MCP_EDGE_OAUTH_DEVICE_CODE_TTL=10m

# Development only. Do not enable in production.
# MCP_EDGE_ENABLE_FIXTURE_MODE=false
